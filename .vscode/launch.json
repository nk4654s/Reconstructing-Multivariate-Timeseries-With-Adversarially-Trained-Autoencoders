    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Summary",
            "type": "debugpy",
            "request": "launch",
            "program": "Comprisk/entrypoints/summary.py",
            "console": "integratedTerminal",
            "args": [
                "-c", "configs/auto_encoder_config.yml"
            ]
        },
        {
            "name": "Python Debugger: Tuner",
            "type": "debugpy",
            "request": "launch",
            "program": "Comprisk/entrypoints/tuner.py",
            "console": "integratedTerminal",
            "args": [
                "-c", "configs/lstm_ae_no_weather.yml",
                "--tuner-config", "configs/tuning/lstm.yml",
                "--tuner-trials", "1"
            ]
        },
        {
            "name": "Python Debugger: Load AE",
            "type": "debugpy",
            "request": "launch",
            "program": "Comprisk/entrypoints/load.py",
            "console": "integratedTerminal",
            "args": [
                "-c", "lightning_logs/AutoEncoder/version_4/config.yml"
            ]
        },
        {
            "name": "Python Debugger: AE",
            "type": "debugpy",
            "request": "launch",
            "program": "Comprisk/entrypoints/trainer.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-c",
                "configs/coarse-to-fine/lstm_coarse.yml",
                "--tag", "debug"
            ]
        },
        {
            "name": "Python Debugger: Future",
            "type": "debugpy",
            "request": "launch",
            "program": "Comprisk/entrypoints/train.py",
            "console": "integratedTerminal",
            "args": [
                "-c",
                "configs/lstm_future.yml",
                "--tag", "debug"
            ]
        },
        {
            "name": "Python Debugger: Generate",
            "type": "debugpy",
            "request": "launch",
            "program": "Comprisk/entrypoints/generate.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-m",
                "models/AutoEncoder/coarse-to-fine/version_2",
                "-d", "configs/regenerate-portal-data/dataset-pipe.yml"
            ]
        },
    ]
}