# exclude generated files
src/*
__pycache__/
*egg-info/
requirements.txt
*.whl
*.jar
*.jpeg
*.jpg
*.png

docs/
build/

# general exclude from model output folders
events.out.tfevents.*
.temp.ckpt
.tmp/
temp/*

# exclude dev environment (but include config set)
environment/dev/models/*
!environment/dev/models/README.md
environment/dev/support_points/*
!environment/dev/support_points/README.md

environment/dev/datasets/
!environment/dev/datasets/dummy_dataset/
!environment/dev/datasets/README.md

# exclude ONNX files from production's config folder
*.onnx
environment/production/configs/*/*/analysis
!environment/production/models/*.onnx

# exclude logs
*.sqlite3
logs/
logfile-bug
logfile.log

# MacOS specific files
.DS_Store

# exclude notebooks
*.ipynb

# specific
/.venv/
.env
/classes/
/maven-archiver/
/logfile
/environment/dev/temp/
