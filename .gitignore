# exclude generated files
src/*
__pycache__/
*egg-info/
requirements.txt
*.whl

docs/
build/

# general exclude from model output folders
*.png
events.out.tfevents.*
.temp.ckpt

# exclude dev environment (but include config set)
environment/dev/models/*
!environment/dev/models/README.md

environment/dev/datasets/
!environment/dev/datasets/README.md

# exclude the datasets from the production environment
environment/production/datasets/
!environment/production/datasets/README.md

# exclude logs
*.sqlite3
logs/
logfile*

# MacOS specific files
.DS_Store

# exclude notebooks
*.ipynb

