environment/dev/datasets/
!environment/dev/datasets/README.md

# exclude the datasets from the production environment
environment/production/datasets/
!environment/production/datasets/README.md

# exclude logs
*.sqlite3
logs/
logfile-bug

# MacOS specific files
.DS_Store

# exclude notebooks
*.ipynb

# specific
/.venv/
.env
/classes/
/maven-archiver/
/logfile
/environment/dev/temp/
