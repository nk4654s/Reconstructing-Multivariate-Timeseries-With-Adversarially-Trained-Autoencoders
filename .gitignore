# exclude generated files
src/*
__pycache__/
*egg-info/
requirements.txt
*.whl
*.jar

docs/
build/

# general exclude from model output folders
*.png
events.out.tfevents.*
.temp.ckpt

# exclude dev environment (but include config set)
environment/dev/models/*
!environment/dev/models/README.md
environment/dev/support_points/*
